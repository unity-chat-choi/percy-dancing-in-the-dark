<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.percy.trigger</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__REPO__/scripts/trigger.sh</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/percy-trigger.log</string>
  <key>StandardErrorPath</key><string>/tmp/percy-trigger.log</string>
</dict>
</plist>
